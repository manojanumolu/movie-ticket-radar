# Copy to .env for local runs, or set these as GitHub Actions secrets.
# .env is gitignored — never commit real values.

# Gmail SMTP (app password, not your account password):
#   https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Only needed when the Streamlit app should mirror its writes to GitHub.
# The Actions workflows use the built-in GITHUB_TOKEN instead.
# GH_TOKEN=github_pat_...

# Override if you fork this under a different name.
# TICKETRADAR_REPO=manojanumolu/movie-ticket-radar

# Firebase Authentication (the app's sign-in). The Web API key is what
# Firebase itself ships inside public web apps — it identifies the project,
# it grants nothing — but keep it here, not in source. No service account,
# no private key: the app never uses the Admin SDK.
#   Firebase console → Project settings → General → Your apps → Web app
# FIREBASE_WEB_API_KEY=AIza...
# FIREBASE_PROJECT_ID=ticketradar-xxxxx
# FIREBASE_AUTH_DOMAIN=ticketradar-xxxxx.firebaseapp.com
