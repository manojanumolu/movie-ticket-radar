# Copy to .env for local runs, or set these as GitHub Actions secrets.
# .env is gitignored — never commit real values.

# Gmail SMTP (app password, not your account password):
#   https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Only needed when the Streamlit app should mirror its writes to GitHub.
# The Actions workflows use the built-in GITHUB_TOKEN instead.
# GH_TOKEN=github_pat_...

# Override if you fork this under a different name.
# TICKETRADAR_REPO=manojanumolu/movie-ticket-radar

# Firebase Authentication (the app's sign-in). The Web API key is what
# Firebase itself ships inside public web apps — it identifies the project,
# it grants nothing — but keep it here, not in source. No service account,
# no private key: the app never uses the Admin SDK.
#   Firebase console → Project settings → General → Your apps → Web app
# FIREBASE_WEB_API_KEY=AIza...
# FIREBASE_PROJECT_ID=ticketradar-xxxxx
# FIREBASE_AUTH_DOMAIN=ticketradar-xxxxx.firebaseapp.com

# Set this only after creating Firestore and publishing firestore.rules.
# Firebase Authentication works without a Firestore database.
# TICKETRADAR_FIRESTORE_ENABLED=true

# Worker only (GitHub Actions secrets): every owner's monitors are read from
# Firestore with a service account. The value is the service-account JSON
# itself, as one string. Never a file in the repository.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# "Continue with Google" — the OAuth Web client Firebase created when the
# Google provider was enabled:
#   Firebase console → Authentication → Sign-in method → Google → Web SDK
#   configuration (Web client ID / Web client secret)
# In Streamlit secrets these live under [google] as client_id / client_secret.
# The secret stays server-side: the browser only ever sees the client id.
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Where Google sends the browser back. Derived from the page's own URL when
# unset (https://<host>/); set it only if that derivation is wrong for your
# host. Whatever it is must be registered on the Web client, exactly:
#   Google Cloud console → APIs & Services → Credentials → the Web client →
#   Authorized redirect URIs
# GOOGLE_OAUTH_REDIRECT_URI=https://movie-ticket-radar.streamlit.app/
