rules_version = '2';

// TicketRadar — user-owned data, keyed on the Firebase Authentication UID.
//
// Deploy: Firebase console → Firestore Database → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules` with the CLI).
//
// Every user-owned document carries `owner_uid`. A signed-in person can only
// read and write documents whose owner_uid is their own UID; nothing else
// about them (email, display name, anything typed on the page) counts. The
// worker on GitHub Actions uses a service account, which bypasses these
// rules by design — it is the only privileged writer and never runs where a
// browser could reach it. It does not trust what these rules let through,
// either: monitor/policy.py re-checks every monitor before it is checked.
//
// A monitor written straight through Firebase's API — bypassing the app —
// meets the same limits the app enforces (the numbers are monitor/policy.py's
// and tests/test_security_hardening.py keeps the two in step):
//   * writes need a verified email address;
//   * only the fields the application writes, with sane sizes;
//   * a running monitor emails the account's own verified address, checks at
//     10/15/30 minutes (5 for the admin claim), carries no admin-only
//     category watch, ends within the 30-day limit, carries at most 12
//     sibling events and costs at most 120 BookMyShow requests per check;
//   * a history line has only the fields the application writes.
// Stopped and expired monitors are only shape-checked, so an older document
// can always be stopped or deleted. What rules cannot count — how many
// monitors one account is running — the app and the worker enforce.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // A sign-in whose address Firebase has verified. Every write needs one.
    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    // The `admin: true` custom claim — set only with the service account
    // (tools/grant_admin.py), never by a client.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function ownsExisting() {
      return signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    function ownsIncoming() {
      return verified() && request.resource.data.owner_uid == request.auth.uid;
    }

    // ── Monitors ─────────────────────────────────────────────────────────
    // Exactly what Monitor.to_dict() writes.
    function monitorFields() {
      return ['id', 'movie', 'targets', 'interval_minutes', 'monitor_until',
              'start_immediately', 'notify_email', 'date_codes', 'status',
              'created_at', 'stopped_at', 'stopped_reason',
              'first_check_requested_at', 'problem', 'owner_uid',
              'categories', 'show_time'];
    }

    function hasNoneOrEmptyList(d, key) {
      return !(key in d) || d[key] == null || (d[key] is list && d[key].size() == 0);
    }

    function hasNoneOrEmptyString(d, key) {
      return !(key in d) || d[key] == null || d[key] == '';
    }

    // The film a monitor watches: exactly MovieRef's fields. Its sibling
    // events are bounded (monitor/policy.py MAX_VARIANTS): each one is
    // another BookMyShow request on every check, and an unbounded list in
    // one document could stall the worker for every account (audit SEC-01).
    function validMovie(m) {
      return m.keys().hasOnly(['platform', 'event_code', 'title', 'region_code', 'region_slug',
                               'city', 'language', 'poster_url', 'source_url', 'variants'])
        && m.keys().hasAll(['platform', 'event_code', 'title', 'region_code', 'region_slug'])
        && m.platform is string && m.platform.size() <= 40
        && m.event_code is string && m.event_code.size() <= 20
        && m.title is string && m.title.size() <= 500
        && (!('variants' in m) || m.variants == null
            || (m.variants is list && m.variants.size() <= 12));
    }

    // One check's BookMyShow requests: one per watched date (one for every
    // date) for the film's event and each sibling — monitor/policy.py
    // request_cost and MAX_REQUESTS_PER_CHECK.
    function requestCost(d) {
      return (('date_codes' in d) && d.date_codes is list && d.date_codes.size() > 0 ? d.date_codes.size() : 1)
        * (1 + (('variants' in d.movie) && d.movie.variants is list ? d.movie.variants.size() : 0));
    }

    function validShape(d, id) {
      return d.keys().hasOnly(monitorFields())
        && d.keys().hasAll(['movie', 'targets', 'interval_minutes', 'monitor_until',
                            'notify_email', 'status', 'owner_uid'])
        && (!('id' in d) || d.id == id)
        && d.movie is map && validMovie(d.movie)
        && d.targets is list && d.targets.size() > 0 && d.targets.size() <= 200
        && d.interval_minutes is int
        && d.status in ['ACTIVE', 'STOPPED', 'EXPIRED']
        && d.notify_email is string && d.notify_email.size() <= 254
        && d.monitor_until is string
        && (!('date_codes' in d) || (d.date_codes is list && d.date_codes.size() <= 62))
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 20))
        && (!('show_time' in d) || d.show_time is string);
    }

    // 'YYYY-MM-DD' for a timestamp, zero-padded.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function isoDate(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    // The app stores ISO-8601 strings ("2026-09-26T23:59:00+05:30"), which
    // sort in time order. A day of margin over the 30-day limit absorbs the
    // UTC/IST difference; the app and the worker hold the exact limit.
    function endsWithinLimit(until) {
      return until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*')
        && until < isoDate(request.time + duration.value(32, 'd'));
    }

    function runningAllowed(d) {
      return d.status != 'ACTIVE' || (
        d.notify_email.lower() == request.auth.token.email.lower()
        && (d.interval_minutes in [10, 15, 30] || (isAdmin() && d.interval_minutes == 5))
        && (isAdmin() || (hasNoneOrEmptyList(d, 'categories') && hasNoneOrEmptyString(d, 'show_time')))
        && endsWithinLimit(d.monitor_until)
        && requestCost(d) <= 120
      );
    }

    function validMonitor(d, id) {
      return validShape(d, id) && runningAllowed(d);
    }

    // Stopping or expiring is always possible, even for a monitor saved before
    // a newer limit (e.g. more than 12 sibling events): the update may change
    // nothing but status (to STOPPED or EXPIRED), stopped_at and stopped_reason.
    // Everything else in the document must be exactly as stored, so this can
    // neither create, restart, extend nor reshape a monitor.
    function isStopOrExpiry() {
      return request.resource.data.status in ['STOPPED', 'EXPIRED']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'stopped_at', 'stopped_reason'])
        && (!('stopped_reason' in request.resource.data) || request.resource.data.stopped_reason == null
            || (request.resource.data.stopped_reason is string && request.resource.data.stopped_reason.size() <= 500))
        && (!('stopped_at' in request.resource.data) || request.resource.data.stopped_at == null
            || (request.resource.data.stopped_at is string && request.resource.data.stopped_at.size() <= 40));
    }

    // users/{uid}: the person's own settings document.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && (!('owner_uid' in request.resource.data) || request.resource.data.owner_uid == uid);
    }

    // An ordinary account may still extend, re-check or stop a monitor it
    // already owns, but never turn it into a different watch: the film, the
    // theatres and formats, the dates and the creation time stay as stored.
    // (Otherwise rewriting an old stopped monitor would be creating a new one.)
    function keepsWatchIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['id', 'movie', 'targets', 'date_codes', 'categories', 'show_time', 'created_at']);
    }

    // monitors/{id}: created only by an authorised admin (the server-set
    // `admin` custom claim); read, stopped, extended and deleted by their owner.
    match /monitors/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming() && isAdmin() && validMonitor(request.resource.data, id);
      allow update: if ownsExisting() && ownsIncoming()
        && ((validMonitor(request.resource.data, id) && (isAdmin() || keepsWatchIdentity()))
            || isStopOrExpiry());
      allow delete: if ownsExisting();
    }

    // monitor_state/{id}: written by the worker only; the owner may read it,
    // and remove it when deleting the monitor.
    match /monitor_state/{id} {
      allow read, delete: if ownsExisting();
      allow create, update: if false;
    }

    // history/{id}: append-only for the owner; the worker appends the rest.
    // Delete is allowed — and only — so that deleting an account can take its
    // own history with it. It is gated on the *existing* document's owner, so
    // one person can never remove another's record, and `update` stays closed
    // so a record cannot be rewritten after the fact.
    // Only the fields record_history writes, with bounded sizes: a history
    // line is a few hundred bytes, never a megabyte of anything (SEC-03).
    function validHistory(d) {
      return d.keys().hasOnly(['owner_uid', 'monitor_id', 'kind', 'message', 'movie', 'language',
                               'poster_url', 'targets', 'at', 'booking_url'])
        && d.kind is string && d.kind.size() <= 40
        && (!('monitor_id' in d) || (d.monitor_id is string && d.monitor_id.size() <= 64))
        && (!('message' in d) || (d.message is string && d.message.size() <= 500))
        && (!('movie' in d) || (d.movie is string && d.movie.size() <= 500))
        && (!('language' in d) || (d.language is string && d.language.size() <= 100))
        && (!('poster_url' in d) || (d.poster_url is string && d.poster_url.size() <= 1000))
        && (!('booking_url' in d) || (d.booking_url is string && d.booking_url.size() <= 1000))
        && (!('at' in d) || (d.at is string && d.at.size() <= 40))
        && (!('targets' in d) || (d.targets is list && d.targets.size() <= 200));
    }

    match /history/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming() && validHistory(request.resource.data);
      allow delete: if ownsExisting();
      allow update: if false;
    }

    // Everything else (the catalogue stays in the repository) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
