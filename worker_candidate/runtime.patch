+            raise Rejected(retryable=400 <= exc.smtp_code < 500) from None
+        if refused:
+            raise Rejected(retryable=any(400 <= c < 500 for c, _ in refused.values()))
+    finally:
+        if server is not None:
+            try:
+                server.close()
+            except (smtplib.SMTPException, OSError):
+                pass
+
